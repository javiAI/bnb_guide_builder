{
  "file": "space_availability_rules.json",
  "version": "2026-06-03",
  "locale": "es-ES",
  "units_system": "metric",
  "description": "Define qué tipos de espacio son obligatorios, recomendados, opcionales o excluidos por roomType. Consumido por getAvailableSpaceTypes() en taxonomy-loader. Los overlays por propertyType y propertyEnvironment se aplican sobre el resultado base para sesgar el selector de creación (servicio resolveSpaceAvailability). Los espacios se configuran libremente en la sección Espacios.",
  "overlaysNote": "Cada overlay sólo puede PROMOVER tipos de 'optional' a 'recommended'. Nunca se altera 'required' ni 'excluded' — la base por roomType manda sobre el contexto.",
  "propertyTypeOverlays": [
    { "propertyType": "pt.house",           "promoteToRecommended": ["sp.garden", "sp.garage", "sp.patio"] },
    { "propertyType": "pt.apartment",       "promoteToRecommended": ["sp.balcony"] },
    { "propertyType": "pt.secondary_unit",  "promoteToRecommended": ["sp.garden", "sp.patio"] },
    { "propertyType": "pt.unique_space",    "promoteToRecommended": ["sp.other"] }
  ],
  "environmentOverlays": [
    { "environment": "env.urban",       "promoteToRecommended": ["sp.balcony"] },
    { "environment": "env.beach",       "promoteToRecommended": ["sp.pool", "sp.patio", "sp.garden"] },
    { "environment": "env.mountain",    "promoteToRecommended": ["sp.garden", "sp.patio"] },
    { "environment": "env.rural",       "promoteToRecommended": ["sp.garden", "sp.patio", "sp.garage"] },
    { "environment": "env.ski",         "promoteToRecommended": ["sp.storage"] },
    { "environment": "env.lake",        "promoteToRecommended": ["sp.patio", "sp.garden"] },
    { "environment": "env.waterfront",  "promoteToRecommended": ["sp.pool", "sp.patio"] },
    { "environment": "env.resort",      "promoteToRecommended": ["sp.pool"] }
  ],
  "rules": [
    {
      "roomType": "rt.entire_place",
      "required":    ["sp.bathroom"],
      "recommended": ["sp.kitchen", "sp.living_room", "sp.bedroom"],
      "optional":    ["sp.dining", "sp.office", "sp.laundry", "sp.balcony", "sp.patio", "sp.garden", "sp.garage", "sp.storage", "sp.pool", "sp.studio", "sp.loft", "sp.open_plan", "sp.kitchen_living", "sp.kitchen_dining_living", "sp.other"],
      "excluded":    ["sp.shared_area"]
    },
    {
      "roomType": "rt.private_room",
      "required":    ["sp.bedroom", "sp.bathroom"],
      "recommended": ["sp.shared_area"],
      "optional":    ["sp.office", "sp.balcony", "sp.storage", "sp.other"],
      "excluded":    ["sp.kitchen", "sp.living_room", "sp.dining", "sp.laundry", "sp.garden", "sp.garage", "sp.pool", "sp.studio", "sp.loft", "sp.open_plan", "sp.kitchen_living", "sp.kitchen_dining_living"]
    },
    {
      "roomType": "rt.shared_room",
      "required":    ["sp.bathroom"],
      "recommended": ["sp.shared_area"],
      "optional":    ["sp.other"],
      "excluded":    ["sp.bedroom", "sp.kitchen", "sp.living_room", "sp.dining", "sp.office", "sp.laundry", "sp.balcony", "sp.patio", "sp.garden", "sp.garage", "sp.storage", "sp.pool", "sp.studio", "sp.loft", "sp.open_plan", "sp.kitchen_living", "sp.kitchen_dining_living"]
    },
    {
      "roomType": "rt.hotel_room",
      "required":    ["sp.bedroom", "sp.bathroom"],
      "recommended": [],
      "optional":    ["sp.balcony", "sp.other"],
      "excluded":    ["sp.kitchen", "sp.living_room", "sp.dining", "sp.office", "sp.laundry", "sp.patio", "sp.garden", "sp.garage", "sp.storage", "sp.pool", "sp.shared_area", "sp.studio", "sp.loft", "sp.open_plan", "sp.kitchen_living", "sp.kitchen_dining_living"]
    },
    {
      "roomType": "rt.other",
      "required":    [],
      "recommended": ["sp.bathroom"],
      "optional":    ["sp.bedroom", "sp.kitchen", "sp.living_room", "sp.dining", "sp.office", "sp.laundry", "sp.balcony", "sp.patio", "sp.garden", "sp.garage", "sp.storage", "sp.pool", "sp.studio", "sp.loft", "sp.shared_area", "sp.open_plan", "sp.kitchen_living", "sp.kitchen_dining_living", "sp.other"],
      "excluded":    []
    }
  ]
}
